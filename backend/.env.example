# Sao chép file này thành .env rồi sửa cho phù hợp với máy của bạn.

PORT=3000

# Khóa bí mật để ký JWT (đổi thành chuỗi ngẫu nhiên dài khi triển khai thật)
JWT_SECRET=bookhub-nhom10-doi-chuoi-nay
JWT_EXPIRES_IN=7d

# Bảo mật đăng nhập
#   BCRYPT_ROUNDS: độ khó khi băm mật khẩu (10-14; càng cao càng chậm, càng khó dò)
#   Nhập sai mật khẩu LOGIN_MAX_ATTEMPTS lần liên tiếp -> tạm khóa đăng nhập LOGIN_LOCK_MINUTES phút
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Kết nối SQL Server. Chọn MỘT trong hai cách:
#
# Cách 1 (mặc định trên Windows): xác thực Windows qua ODBC, KHÔNG cần bật TCP/IP.
#   Cần cài "ODBC Driver 17 for SQL Server" (hoặc 18) - thường có sẵn khi cài SSMS.
DB_DRIVER=msnodesqlv8
DB_SERVER=localhost
# Instance Express thì dùng: DB_SERVER=.\SQLEXPRESS
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
#
# Cách 2: tài khoản SQL Server (sa...) qua TCP 1433.
#   Cần bật TCP/IP trong SQL Server Configuration Manager.
# DB_DRIVER=tedious
# DB_SERVER=localhost
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=matkhau
# ---------------------------------------------------------------------------
DB_NAME=BookHubDB

# Thư mục lưu file PDF và ảnh bìa (tương đối với thư mục backend)
UPLOAD_DIR=uploads
# Dung lượng tối đa mỗi file tải lên (MB)
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Thông báo đẩy Firebase Cloud Messaging (TÙY CHỌN - bỏ trống thì vẫn chạy bình thường,
# thông báo chỉ hiện trong ứng dụng ở màn hình Thông báo).
#   1. npm install firebase-admin
#   2. Firebase Console -> Project settings -> Service accounts -> Generate new private key
#   3. Lưu file JSON vào thư mục backend (KHÔNG đưa lên Git) rồi ghi đường dẫn bên dưới.
# FCM_SERVICE_ACCOUNT=firebase-service-account.json
