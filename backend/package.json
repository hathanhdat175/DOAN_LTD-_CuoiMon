{
  "name": "bookhub-api",
  "version": "1.1.0",
  "description": "REST API cho ứng dụng đọc sách BookHub (Nhóm 10) - Node.js/Express + SQL Server",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup-db": "node scripts/setup-db.js",
    "migrate": "node scripts/migrate.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.10",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.6.0"
  }
}
